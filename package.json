{
  "name": "@cyango-tools/skills",
  "version": "1.5.22",
  "description": "CLI to install Cyango agent skills",
  "type": "module",
  "scripts": {
    "sync:skill-version": "node scripts/sync-skill-version.mjs",
    "types:skill": "node scripts/extract-skill-types.mjs",
    "prepack": "npm run types:skill && npm run sync:skill-version",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "publish:patch": "node scripts/release.mjs patch",
    "publish:minor": "node scripts/release.mjs minor",
    "publish:major": "node scripts/release.mjs major",
    "publish:npm": "npm publish --access public --registry https://registry.npmjs.org/ '--@cyango-tools:registry=https://registry.npmjs.org/'",
    "publish:skills-sh": "node scripts/publish-skills-sh.mjs",
    "build:openai": "node scripts/build-openai-plugin.mjs"
  },
  "bin": {
    "cyango-skills": "bin/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "plugin/skills"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
